{
  "name": "dsh-prompt-optimizer",
  "version": "0.1.0",
  "description": "DSH 首条提示词优化器：先按你的个人画像推测真实意图，给出 A《保守精确》/ B《结构化重述》两版改写，你选定后才开始干活。 / First-prompt optimizer for DeepSeek Harness: infers intent from your personal profile, offers two optimized variants, and enters the step with the variant you pick.",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "prompt",
    "prompt-optimizer"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "persona.example.md",
    "docs/"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    },
    "engines": {
      "dsh": ">=0.1.2-rc.1"
    }
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.1.2-rc.1",
    "react": "^18.3.1"
  },
  "license": "MIT",
  "author": "phy1234669",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phy1234669/dsh-prompt-optimizer.git"
  },
  "homepage": "https://github.com/phy1234669/dsh-prompt-optimizer#readme",
  "bugs": {
    "url": "https://github.com/phy1234669/dsh-prompt-optimizer/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
